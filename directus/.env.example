# Copy to .env and fill in real values:
#   cp .env.example .env

# Postgres (PostGIS 16)
DB_USER=directus
DB_PASSWORD=change_me_db_password
DB_DATABASE=directus

# Directus admin bootstrap (created on first start only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

# Directus instance secret
SECRET=change_me_random_string

# Host port Directus is published on
DIRECTUS_PORT=8055

# Connect to the DB and count all tables
# docker compose exec database psql -U directus directus -c "\dt"

# 1. Generate the raw snapshot file inside your running Directus container
# docker compose exec directus node cli.js schema snapshot /tmp/snap.json

# 2. Copy the file out of the container onto your local host machine
# docker compose cp directus:/tmp/snap.json ./snap.json








